+		{ "open_playlist",    "audio-x-mpegurl",            "media-playlist",        0,               0 },
+		{ "dvd",              "media-optical-dvd",          "gnome-dev-disc-dvdrom", "media-optical", 0 },
+		{ "dvd_drive",        "media-optical-dvd",          "gnome-dev-disc-dvdrom", "media-optical", 0 },
+		{ "dvd_hd",           "folder-videos",              "video-x-generic",       0,               0 },
+		{ "vcd",              "media-optical-video",        "media-optical",         0,               0 },
+		{ "cdda",             "media-optical-audio",        "gnome-dev-cdrom-audio", "media-optical", 0 },
+		{ "url",              "applications-internet",      "emblem-web",            "insert-link",   0 },
+		{ "open_radio",       "internet-radio-new",         "library-internet-radio", 0,              0 },
+		{ "close",            "window-close",               "application-exit",      0,               0 },
+		{ "exit",             "application-exit",           0,                       0,               0 },
+		// Play
+		{ "play",             "media-playback-start",       0,                       0,               0 },
+		{ "pause",            "media-playback-pause",       0,                       0,               0 },
+		{ "stop",             "media-playback-stop",        0,                       0,               0 },
+		{ "frame_step",       "stock_goto_last",            0,                       0,               0 },
+		{ "rewind10s",        "media-seek-backward",        0,                       0,               0 },
