+		{ "panscan",          "zoom-in",                    0,                       0,               0 },
+		{ "aspect",           "system-config-display",      "video-display",         0,               0 },
+		{ "deinterlace",      "format-justify-fill",        0,                       0,               0 },
+		{ "video_filters",    "system-run",                 0,                       0,               0 },
+		{ "rotate",           "object-rotate-right",        0,                       0,               0 },
+		{ "flip",             "object-flip-vertical",       0,                       0,               0 },
+		{ "mirror",           "object-flip-horizontal",     0,                       0,               0 },
+		{ "equalizer",        "colors",                     0,                       0,               0 },
+		{ "screenshot",       "camera-photo",               "applets-screenshooter", 0,               0 },
+		{ "screenshots",      "ksnapshot",                  "applets-screenshooter", 0,               0 },
+		{ "ontop",            "go-top",                     0,                       0,               0 },
+		{ "video_preview",    "view-calendar-month",        0,                       0,               0 },
