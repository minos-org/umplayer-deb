+		{ "toolbars",         "gnome-panel",                0,                       0,               0 },
+		{ "logs",             "logviewer",                  0,                       0,               0 },
+		{ "prefs",            "preferences-desktop",        "preferences-system",    0,               0 },
+		{ "preferences",      "preferences-desktop",        "preferences-system",    0,               0 },
