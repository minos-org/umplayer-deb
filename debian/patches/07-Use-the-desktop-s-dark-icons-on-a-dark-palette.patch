+		{ "open_tv",          "video-television",           "tv",                    "video-display", 0 },
+		{ "pref_advanced",    "emblem-system",              "preferences-other",     0,               0 },
+		// the actions, menu by menu (the same actions fill the popup, the tray menu, the toolbars
+		// and the shortcuts table)
+		// Open
+		{ "file",             "text-x-generic",             "document-open",         0,               0 },
+		{ "recents",          "document-open-recent",       0,                       0,               0 },
+		{ "delete",           "edit-clear",                 0,                       0,               0 },
