+		{ "open",             "document-open",              0,                       0,               0 },
+		{ "save",             "document-save",              0,                       0,               0 },
+		{ "playlist_open",    "document-open",              0,                       0,               0 },
+		{ "playlist_save",    "document-save",              0,                       0,               0 },
+		{ "plus",             "list-add",                   0,                       0,               0 },
+		{ "minus",            "list-remove",                0,                       0,               0 },
+		{ "playlist_up",      "go-up",                      0,                       0,               0 },
+		{ "playlist_down",    "go-down",                    0,                       0,               0 },
+	};
+
+	if (size.isEmpty() || qApp->palette().color(QPalette::Window).lightness() >= 128) return QPixmap();
+
+	for (unsigned int n = 0; n < sizeof(map) / sizeof(map[0]); n++) {
+		if (name != QLatin1String(map[n][0])) continue;
+		for (int t = 1; t < 5 && map[n][t]; t++) {
+			// hasThemeIcon is exact: a name found only by dropping a "-suffix" does not count
+			if (QIcon::hasThemeIcon(QLatin1String(map[n][t]))) {
+				return QIcon::fromTheme(QLatin1String(map[n][t])).pixmap(size);
+			}
+		}
+		break;
+	}
+	return QPixmap();
+}
+
 QPixmap Images::icon(QString name, int size, bool png) {
