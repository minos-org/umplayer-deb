+		{ "previous",         "media-skip-backward",        0,                       0,               0 },
+		{ "next",             "media-skip-forward",         0,                       0,               0 },
+		// Video; laga has no funnel, so both menus of filters take its gear
+		{ "video_track",      "video-x-generic",            0,                       0,               0 },
+		{ "fullscreen",       "view-fullscreen",            0,                       0,               0 },
