+		{ "forward1m",        "go-next",                    0,                       0,               0 },
+		{ "rewind10m",        "go-first",                   0,                       0,               0 },
+		{ "forward10m",       "go-last",                    0,                       0,               0 },
+		{ "speed",            "chronometer",                0,                       0,               0 },
